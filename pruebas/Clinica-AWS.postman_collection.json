    {
      "name": "01 - Salud del despliegue AWS",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('documentoPrueba', 'PM' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 24));",
              "['pacienteId', 'citaId', 'segundaCitaId'].forEach(function (key) { pm.collectionVariables.set(key, ''); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "var responseBody = pm.response.json();",
              "pm.test(\"Servicio y base de datos UP\", function () { pm.expect(responseBody.status).to.eql('UP'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear paciente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"documento\": \"{{documentoPrueba}}\",\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"Prueba AWS\",\n  \"fechaNacimiento\": \"2000-05-10\",\n  \"email\": \"ana.aws@example.com\",\n  \"telefono\": \"3001234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "var responseBody = pm.response.json();",
              "pm.test(\"Identificador generado\", function () { pm.expect(responseBody.id).to.be.a('number').and.above(0); });",
              "pm.test(\"Documento enviado conservado\", function () { pm.expect(responseBody.documento).to.eql(pm.collectionVariables.get('documentoPrueba')); });",
              "pm.test(\"Location del paciente\", function () { pm.expect(pm.response.headers.get('Location')).to.eql('/api/pacientes/' + responseBody.id); });",
              "pm.collectionVariables.set('pacienteId', responseBody.id);"
            ]
          }
        }
      ]
    },
